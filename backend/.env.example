PORT=5000

# MySQL connection
DB_HOST=localhost
DB_PORT=3306
DB_NAME=school_erp
DB_USER=root
DB_PASSWORD=your_mysql_password

# JWT
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# Default admin created by `npm run seed`
ADMIN_NAME=Super Admin
ADMIN_EMAIL=admin@school.com
ADMIN_PASSWORD=Admin@123

# Frontend origin (for CORS)
CLIENT_URL=http://localhost:5173

# Optional: email notifications (leave blank to disable — in-app notifications
# still work fine without this). Example uses Gmail SMTP with an app password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
